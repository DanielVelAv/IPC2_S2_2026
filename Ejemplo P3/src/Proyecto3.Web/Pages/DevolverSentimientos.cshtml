@page
@model DevolverSentimientosModel
@* @page = esta página tiene URL propia · @model = su clase PageModel *@
@{
    ViewData["Title"] = "Devolver Sentimientos";
}
@* Un @section no puede ir dentro de un if, pero un if sí puede ir dentro del @section *@
@section Estilos {
    @if (Model.SentP == null)
    {
        <link rel="stylesheet" href="~/css/StyleDevolverH.css">
    }
    else
    {
        <link rel="stylesheet" href="~/css/StyleListados.css">
    }
}

@if (Model.SentP == null)
{
    @* ----- Formulario (ConsultarSentimientos.html) ----- *@
    <form method="post" id="Has">
        <center>
            <h1>Devolver Sentimientos</h1>
            <label><input type="date" id="PrimerRango" name="PrimerRango" required></label>
            <label><input type="date" id="SegundoRango" name="SegundoRango" required></label><br><br>
            <button type="submit" id="btn">Mostrar Datos</button>
        </center>
    </form>
}
else
{
    @* ----- Resultado (RecibeSentimientos.html) ----- *@
    <section id="contenido">
        <center>
            <h1>Listado de Sentimientos Filtrado</h1>
            @foreach (var (fecha, senP) in Model.SentP.Positivos)
            {
                <p id="fecha">****@fecha****</p>
                <p>Mensajes Positivos: @senP</p>
                <p>Mensajes Negativos: @Model.SentP.Negativos[fecha]</p>
                <p>Mensajes Neutros: @Model.SentP.Neutros[fecha]</p>
            }
        </center>
    </section>
}
