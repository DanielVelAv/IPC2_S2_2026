@page
@model PedirDiccionarioModel
@* @page = esta página tiene URL propia · @model = su clase PageModel *@
@{
    ViewData["Title"] = "Añadir Diccionario";
}
@section Estilos {
    <link rel="stylesheet" href="~/css/StylePrincipal.css">
}

<center>
    <form method="post" enctype="multipart/form-data" id="frmA">
        <p id="IAAS">Ingrese el archivo de diccionario a subir</p>
        <input type="file" id="archivoDicc" name="archivoDicc" required><br><br>
        <button type="submit" id="Ing">Enviar Diccionario</button>

        @if (Model.Mensaje != null)
        {
            <p>@Model.Mensaje</p>
        }
    </form>
</center>
